# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key for signing JSON Web Tokens.
JWT_SECRET="your_super_secret_jwt_key_here"

# SMTP Configuration: Required for sending email notifications.
# Obtain these from your email provider (e.g., Gmail, SendGrid, Mailgun).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# MongoDB configuration
# Use your Atlas connection string with the replica set hosts if SRV lookups fail.
# Example:
# mongodb://user:password@host1:27017,host2:27017,host3:27017/dbname?authSource=admin&replicaSet=atlas-xxx-shard-0&tls=true&retryWrites=true&w=majority
MONGO_URI="mongodb://mc25106677_db_user:om%40123@ac-qyiuign-shard-00-00.y0xedun.mongodb.net:27017,ac-qyiuign-shard-00-01.y0xedun.mongodb.net:27017,ac-qyiuign-shard-00-02.y0xedun.mongodb.net:27017/campusevent?authSource=admin&replicaSet=atlas-upyyxg-shard-0&tls=true&retryWrites=true&w=majority"
MONGO_DB_NAME="campusevent"
